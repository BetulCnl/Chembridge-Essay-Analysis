{
  "title": "WeeklyDigest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "week": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "total": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "bySource": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "topIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rising": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chem": {
            "type": "string"
          },
          "cs": {
            "type": "string"
          },
          "recent": {
            "type": "number"
          },
          "growth": {
            "type": "number"
          }
        },
        "required": [
          "chem",
          "cs",
          "recent",
          "growth"
        ],
        "additionalProperties": false
      }
    },
    "quiet": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chem": {
            "type": "string"
          },
          "cs": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "avgScore": {
            "type": "number"
          }
        },
        "required": [
          "chem",
          "cs",
          "count",
          "avgScore"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "week",
    "from",
    "to",
    "total",
    "bySource",
    "topIds",
    "rising",
    "quiet"
  ],
  "additionalProperties": false
}
