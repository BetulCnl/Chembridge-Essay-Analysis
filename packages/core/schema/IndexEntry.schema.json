{
  "title": "IndexEntry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "preprint",
        "article",
        "news"
      ]
    },
    "venue": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "chem": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "csInferred": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "code": {
      "type": "boolean"
    },
    "data": {
      "type": "boolean"
    },
    "bucket": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "title",
    "date",
    "source",
    "type",
    "venue",
    "score",
    "chem",
    "cs",
    "csInferred",
    "cells",
    "code",
    "data",
    "bucket"
  ],
  "additionalProperties": false
}
