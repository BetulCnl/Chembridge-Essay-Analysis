{
  "$comment": "ChemBridge pipeline configuration. Endpoints were verified on 2026-10-24, see docs/SOURCES.md.",
  "backfillDays": 180,
  "retentionDays": 180,
  "overlapDays": 3,
  "rawRetentionDays": 7,
  "publish": {
    "minScore": 20,
    "minScoreNews": 8,
    "maxItems": 12000,
    "buckets": 64,
    "excerptChars": 600,
    "feedItems": 40,
    "feedDays": 7,
    "weeklyTop": 15
