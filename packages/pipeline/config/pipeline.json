  "sources": {
    "arxiv": {
      "enabled": true,
      "pageSize": 500,
      "chemCategories": ["physics.chem-ph", "cond-mat.mtrl-sci", "q-bio.BM", "cond-mat.soft"],
      "csCategories": ["cs.LG", "cs.AI", "cs.CE"],
      "queries": [
        {
          "id": "chem",
          "search": "(cat:physics.chem-ph OR cat:cond-mat.mtrl-sci OR cat:q-bio.BM)"
        },
        {
          "id": "cs-chem",
          "search": "(cat:cs.LG OR cat:cs.AI OR cat:cs.CE) AND (abs:molecular OR abs:molecule OR abs:molecules OR abs:chemistry OR abs:chemical OR abs:catalyst OR abs:catalysis OR abs:materials OR abs:protein OR abs:drug OR abs:polymer OR abs:battery OR abs:crystal OR abs:reaction)"
        }
      ]
    },
    "chemrxiv": {
      "enabled": true,
      "pageSize": 500,
      "doiPrefix": "10.26434"
    },
    "biorxiv": {
      "enabled": true,
      "server": "biorxiv",
      "categories": [
        "biochemistry",
        "biophysics",
        "synthetic biology",
        "pharmacology and toxicology"
      ]
    },
    "medrxiv": {
      "enabled": false,
      "server": "medrxiv",
      "categories": ["pharmacology and therapeutics"]
    },
    "europepmc": {
